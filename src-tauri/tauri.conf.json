{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/blank_config.bin",
      "resources/rboot.bin",
      "resources/Sonoff_OFF.bin",
      "resources/Sonoff_ON.bin"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "bin/esptool"
    ],
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "hardenedRuntime": true,
      "minimumSystemVersion": "10.15",
      "providerShortName": "lockie.dev"
    }
  },
  "productName": "Sonoff Homekit Flasher",
  "mainBinaryName": "Sonoff Homekit Flasher",
  "version": "0.0.1",
  "identifier": "me.lockie.sonoff-homekit-flasher",
  "plugins": {},
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "Sonoff Homekit Flasher",
        "width": 800,
        "height": 600,
        "resizable": false,
        "hiddenTitle": true,
        "minimizable": false,
        "visible": false,
        "center": true,
        "useHttpsScheme": true
      }
    ]
  }
}